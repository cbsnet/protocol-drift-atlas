# Protocol Drift Atlas — example environment file
#
# Copy this file to `.env` and fill in your key.
# `.env` is excluded from Git by `.gitignore`.
# Never commit `.env` or any file containing a real API key.

OPENAI_API_KEY=replace-with-your-key
OPENAI_DEFAULT_MODEL=gpt-4o-mini-2024-07-18
OPENAI_COMPARISON_MODEL=gpt-4.1-mini-2025-04-14